<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://schoolClassBrowse.caption"
        focusComponent="schoolClassesTable"
        messagesPack="com.company.schoolmanagement.web.screens.schoolclass">
    <data readOnly="true">
        <collection id="schoolClassesDc"
                    class="com.company.schoolmanagement.entity.SchoolClass">
            <view extends="_local">
                <property name="school" view="_minimal"/>
                <property name ="students" view ="_minimal"/>
            </view>
            <loader id="schoolClassesDl"/>

        </collection>
        <collection id="schoolsDc"
                    class="com.company.schoolmanagement.entity.School"
                    view="_local">
            <loader id = "schoolsDl">
                <query>
                    <![CDATA[
                select e from schoolmanagement_School e
                    ]]>
                </query>
            </loader>
        </collection>
    </data>


    <dialogMode height="600"
                width="800"/>
    <layout expand="schoolClassesTable"
            spacing="true">
        <filter id="filter"
                applyTo="schoolClassesTable"
                dataLoader="schoolClassesDl">
            <properties include=".*"/>
        </filter>
        <groupTable id="schoolClassesTable"
                    width="100%"
                    dataContainer="schoolClassesDc"
                    aggregatable="true"
                    aggregationStyle="BOTTOM">
            <actions>
                <action id="create" type="create"/>
                <action id="edit" type="edit"/>
                <action id="remove" type="remove"/>
                <action id="refresh" type="refresh"/>
            </actions>

            <columns>
                <column id="name" align="CENTER"/>
                <column id="grade" align="CENTER"/>
<!--                <column id="action"/>-->
                <column id ="capacity" align="CENTER" >
                    <aggregation type = "SUM"/>
                </column>
                <column id ="studentCount" align = "CENTER"/>

            </columns>
<!--            <rowsCount/>-->

            <buttonsPanel id="buttonsPanel"
                          alwaysVisible="true">
                <button id="createBtn" action="schoolClassesTable.create"/>
                <button id="editBtn" action="schoolClassesTable.edit"/>
                <button id="removeBtn" action="schoolClassesTable.remove"/>
                <button id="refreshBtn" action="schoolClassesTable.refresh"/>
                <hbox id="schoolFilterBox" spacing="true">
                    <label value="School:"/>
                    <lookupPickerField id="schoolFilter"
                                       optionsContainer="schoolsDc"/>
                </hbox>

            </buttonsPanel>
        </groupTable>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>

    </layout>

</window>
